# Боевой Caddyfile: minenkovrehab.ru (сайт), www → редирект, new — тестовая копия (basic auth), api → backend (Robokassa Result URL).
# Сертификаты выпускает lego с Мака (DNS-01 через Cloudflare), кладём в ./certs:
#   main.crt/main.key — minenkovrehab.ru, www, api;  site.crt/site.key — new.minenkovrehab.ru.
# Как на radar152: HTTP/3 выключен + Alt-Svc clear, grace_period. Журнал запросов — только для minenkovrehab.ru (JSON, с ротацией).
# Кнопка «Наверх»: /_rx/rx-scroll-top.js из ./extras, подключается в HTML через replace (плагин replace-response, образ rehab-caddy).
{
	email <acme-email>
	grace_period 10s
	order replace after encode
	servers {
		protocols h1 h2
	}
}

(secure) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		Alt-Svc "clear"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https://auth.robokassa.ru; upgrade-insecure-requests"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-X-Powered-By
		-Server
	}
}

http://minenkovrehab.ru, http://www.minenkovrehab.ru, http://api.minenkovrehab.ru, http://new.minenkovrehab.ru {
	handle /.well-known/acme-challenge/* {
		root * /srv/acme
		file_server
	}
	handle {
		redir https://{host}{uri} 308
	}
}

https://minenkovrehab.ru {
	tls /certs/main.crt /certs/main.key
	import secure
	# Журнал запросов (JSON) в томе caddy_data: на хосте — том rehab_caddy_data, в контейнере /data/logs.
	log {
		output file /data/logs/minenkovrehab-access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
	# Метаданные, sitemap, robots, картинки превью, кнопка «Наверх» и Метрика — в коде сайта (ветка seo-audit).
	reverse_proxy frontend:3000
}

https://www.minenkovrehab.ru {
	tls /certs/main.crt /certs/main.key
	import secure
	redir https://minenkovrehab.ru{uri} 301
}

https://api.minenkovrehab.ru {
	tls /certs/main.crt /certs/main.key
	import secure
	handle /api/robokassa/* {
		reverse_proxy backend:3101
	}
	handle /health/live {
		reverse_proxy backend:3101
	}
	handle /payment/* {
		redir https://minenkovrehab.ru{uri} 303
	}
	handle {
		redir https://minenkovrehab.ru 302
	}
}

https://new.minenkovrehab.ru {
	tls /certs/site.crt /certs/site.key
	import secure
	# Тестовая копия (ветка redesign, контейнер rehab-staging/frontend-staging). Закрыта паролем, не индексируется.
	header X-Robots-Tag "noindex, nofollow"
	route {
		# robots.txt отдаётся без пароля, чтобы роботы видели запрет.
		@robots path /robots.txt
		header @robots Content-Type "text/plain; charset=utf-8"
		respond @robots <<TXT
			User-agent: *
			Disallow: /
			TXT 200
		basic_auth {
			# Хеш bcrypt пароля — только на сервере, в репозиторий не кладём.
			vadim <bcrypt-hash>
		}
		# Заголовок basic auth дальше сайта и бэкенда не уходит.
		request_header -Authorization
		# Без Метрики и без файла IndexNow.
		@metrika path /js/metrika.js
		header @metrika Content-Type "text/javascript; charset=utf-8"
		respond @metrika "/* Метрика на тестовой копии отключена */" 200
		@indexnow path /bcc8f8593ece76dda52e5a727c39f4b8.txt
		respond @indexnow 404
		# Оплата отключена: заказы в бэкенд и Robokassa не уходят.
		@payment path /api/checkout /api/checkout/* /api/robokassa/*
		header @payment Content-Type "application/json; charset=utf-8"
		respond @payment `{"success":false,"error":"На тестовой версии оплата отключена"}` 403
		# Бэкенд принимает Origin только боевого сайта (CSRF). Запросы с самой тестовой копии
		# передаём с боевым Origin; чужие Origin не трогаем — бэкенд их отклонит.
		@self header Origin https://new.minenkovrehab.ru
		request_header @self Origin https://minenkovrehab.ru
		reverse_proxy frontend-staging:3000
	}
}
