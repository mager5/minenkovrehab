{
  "name": "minenkovrehab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fast": "next dev",
    "dev:clean": "node scripts/dev-clean.mjs && next dev",
    "build": "next build --webpack",
    "start": "next start",
    "start:dev": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/pre-commit-check.js",
    "check:full": "node scripts/pre-commit-check.js --e2e",
    "check:fast": "node scripts/pre-commit-check.js --skip-build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "node scripts/e2e-tests.js",
    "analyze:complexity": "npx eslint src --ext .ts,.tsx,.js,.jsx --format json > reports/complexity.json || true",
    "analyze:duplicates": "npx jscpd src",
    "analyze:all": "npm run analyze:complexity && npm run analyze:duplicates",
    "quality:check": "node scripts/code-quality-analysis.js",
    "precommit": "npm run check",
    "prepare": "husky",
    "build:migration": "node scripts/build-migration.cjs",
    "ai:test": "node scripts/ai-test-start.mjs",
    "test:ai-title": "node --test scripts/ai-title.test.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "@heygen/streaming-avatar": "2.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "framer-motion": "^10.16.4",
    "hls.js": "^1.6.16",
    "livekit-client": "^2.15.3",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.525.0",
    "next": "16.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.71.1",
    "react-icons": "^4.11.0",
    "resend": "6.32.1",
    "swiper": "14.3.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.8.2",
    "@types/react": "^18.2.24",
    "@types/react-dom": "^18.2.8",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "autoprefixer": "^10.4.16",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "^16.1.2",
    "postcss": "8.5.29",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@heygen/streaming-avatar": {
      "protobufjs": "7.6.5"
    }
  },
  "engines": {
    "node": ">=20.19.0 <25"
  }
}
