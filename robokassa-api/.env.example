# Robokassa API Configuration

# Основные настройки Robokassa
ROBOKASSA_LOGIN=your_shop_login
ROBOKASSA_PASSWORD1=your_password_1
ROBOKASSA_PASSWORD2=your_password_2

# Тестовые настройки Robokassa (для разработки)
ROBOKASSA_TEST_PASSWORD1=Jhv36AzmB3zocF1xE8eO
ROBOKASSA_TEST_PASSWORD2=r1F3CfGwp65LMXczFt4l

# Режим работы (true для тестового режима, false для продакшена)
ROBOKASSA_TEST_MODE=true

# URL фронтенда (для Success/Fail страниц)
FRONTEND_URL=https://minenkovrehab.github.io

# Настройки сервера
PORT=3000
NODE_ENV=development

# CORS настройки (разрешенные домены)
ALLOWED_ORIGINS=https://minenkovrehab.github.io,http://localhost:3000,http://127.0.0.1:3000